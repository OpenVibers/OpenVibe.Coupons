# ═══════════════════════════════════════════════════════════════
# openvibe.coupons — environment configuration (names only; never commit values)
# Copy to .env for development. Production: /etc/openvibe/coupons.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4850
HOST=127.0.0.1
NODE_ENV=development
# Public origin: canonical URLs, feeds, sitemaps and JSON-LD are built from it
BASE_URL=http://localhost:4850
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2). Per-IP rate limits use it.
TRUST_PROXY=2

# SQLite database (production unit: /var/lib/openvibe-coupons/coupons.db)
COUPONS_DB_PATH=./data/coupons.db

# OpenVibe.Network — SSO (OAuth2), JWKS, client-credentials tokens
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client `coupons` (redirect https://openvibe.coupons/auth/callback). The same client is the
# service principal svc:coupons for client-credentials grants (see README, "Grants").
OV_OAUTH_CLIENT_ID=coupons
OV_OAUTH_CLIENT_SECRET=
# Production: https://openvibe.coupons/auth/callback (default: BASE_URL + /auth/callback)
#OV_OAUTH_REDIRECT_URI=
# Cookies: Secure by default in production; set false for plain-http local development
#COOKIE_SECURE=false
# Signs the form tokens (CSRF). Unset: random per process.
#COUPONS_FORM_SECRET=
# Keys the reporter column (HMAC of the person). Set it in production; changing it restarts
# same-day deduplication. Unset: a development key (and /api/ready says so).
#COUPONS_REPORTER_KEY_SECRET=

# Staff (review, moderation): Network admins, plus these subjects (usr_…, comma-separated)
#COUPONS_STAFF_SUBJECTS=

# Browser helper: extension origins allowed by CORS on the two lookup routes only.
# Exact origins (chrome-extension://<id>) or the literal moz-extension://* (Firefox install origins
# are random). Empty: no CORS; the helper still works through its host permission.
#COUPONS_EXTENSION_ORIGINS=
# Extension install tokens expire after this many days
#COUPONS_INSTALL_TTL_DAYS=365

# Rate limits
#COUPONS_LOOKUP_ANON_PER_MIN=30
#COUPONS_LOOKUP_TOKEN_PER_MIN=120
#COUPONS_LOOKUP_SERVICE_PER_MIN=600
#COUPONS_REPORTS_PER_HOUR=20
#COUPONS_REPORTS_PER_DAY=60
#COUPONS_SUBMISSIONS_PER_HOUR=10
#COUPONS_SUBMISSIONS_PER_DAY=30
#COUPONS_INSTALLS_PER_SUBJECT=10

# OpenVibe.Sources — import the `coupons` category (runs when this and OV_OAUTH_CLIENT_SECRET are set)
#OV_SOURCES_INTERNAL_URL=http://127.0.0.1:4720
# Only these source keys (comma-separated); empty: every coupons source. Others are held as not_selected.
#COUPONS_SOURCES_KEYS=staff-coupon-codes
#COUPONS_SOURCES_INTERVAL_MS=600000
# true: imported codes are listed without staff review (still status unknown)
#COUPONS_SOURCES_AUTO_PUBLISH=false

# OpenVibe.Events — the outbox relay runs only when EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# Expiry / confidence-decay sweep (in-process); off: COUPONS_WORKER=off
#COUPONS_WORKER=on
#COUPONS_SWEEP_INTERVAL_MS=60000

# release.json (openvibe-shared/release): the deployed commit when git is not available
#RELEASE_COMMIT=
#MIN_CLIENT_RELEASE=
